# ==============================================================================
# Triple A / KPW MoveWell Environment Configuration Template
# Copy this file to '.env' and populate with your local/staging credentials.
# NOTE: Never commit your real '.env' file to source control.
# ==============================================================================

# Database Connection (SQL Server)
# Format: Server=<host>;Database=<db_name>;User Id=<user>;Password=<password>;Encrypt=True;TrustServerCertificate=True;...
DB_CONNECTION_STRING="Server=sql.example.com;Database=KPW_MoveWell;User Id=kpw_app;Password=YOUR_DB_PASSWORD;Encrypt=True;TrustServerCertificate=True;MultipleActiveResultSets=False;"
ConnectionStrings__DefaultConnection="Server=sql.example.com;Database=KPW_MoveWell;User Id=kpw_app;Password=YOUR_DB_PASSWORD;Encrypt=True;TrustServerCertificate=True;MultipleActiveResultSets=False;"

# JWT Authentication
# Symmetric 256-bit+ secret key for signing tokens
JWT_KEY="YOUR_SUPER_SECRET_JWT_SIGNING_KEY_HERE"
JWT_ISSUER="KPW.MoveWell"
JWT_AUDIENCE="KPW.MoveWell.Clients"

# SendGrid Email Configuration
# Provider: "SendGrid" to send live emails, or "Logging" for local dev logging fallback
SENDGRID_PROVIDER="Logging"
SENDGRID_API_KEY="SG.your_sendgrid_api_key_here"
SENDGRID_FROM_EMAIL="noreply@mytriplea.co.za"
SENDGRID_FROM_NAME="Triple A"

# Google Cloud & Gemini AI Configuration
GOOGLE_APPLICATION_CREDENTIALS="devson-development-6d4da133b74e.json"
AI_PROVIDER="Local"
AI_API_KEY="YOUR_GEMINI_API_KEY"
AI_MODEL="gemini-3.5-flash-lite"
