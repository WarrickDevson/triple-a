# ==============================================================================
# Triple-A (MoveWell) Backend API Configuration Template
# ==============================================================================

# Database Connection (SQL Server)
ConnectionStrings__DefaultConnection=Server=sql.devson.co.za;Database=KPW_MoveWell;User Id=kpw_app;Password=YOUR_DB_PASSWORD;Encrypt=True;TrustServerCertificate=True;MultipleActiveResultSets=true

# JWT Authentication
Jwt__Key=YOUR_SECRET_JWT_KEY_AT_LEAST_32_CHARS
Jwt__Issuer=KPW.MoveWell
Jwt__Audience=KPW.MoveWell.Clients

# AI & Speech Services (Google Gemini)
# 1. Get your free key at https://aistudio.google.com/
# 2. Paste the key below (starts with AIzaSy...)
Ai__Provider=Gemini
Ai__ApiKey=YOUR_GEMINI_API_KEY_HERE
Ai__Model=gemini-3.5-flash-lite

# SendGrid Email Services
SendGrid__ApiKey=YOUR_SENDGRID_API_KEY_HERE
SendGrid__FromEmail=noreply@mytriplea.co.za
SendGrid__FromName=Triple A
